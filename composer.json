{
  "name": "bjuppa/metatagbag",
  "description": "A convenient collection for HTML meta tags",
  "keywords": [
    "meta-tag",
    "bag",
    "collection",
    "laravel"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Björn Nilsved",
      "email": "nilsved@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0.5"
  },
  "autoload": {
    "psr-4": {
      "Bjuppa\\MetaTagBag\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bjuppa\\MetaTagBag\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  }
}